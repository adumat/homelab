{
  "id": "vyos-amd64",
  "name": "vyos-amd64",
  "boot": {
    "kernel": "/assets/vyos/vmlinuz",
    "initrd": ["/assets/vyos/initrd.img"],
    "args": [
      "boot=live",
      "nopersistence",
      "noautologin",
      "ip=dhcp",
      "fetch=http://192.168.1.3:8085/assets/vyos/filesystem.squashfs",
      "console=tty0"
    ]
  }
}

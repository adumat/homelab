{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    // ── Umbrella: every patch across all managers, once per week ──────
    {
      description: "All patch updates (weekly batch)",
      matchUpdateTypes: ["patch"],
      groupName: "all patch updates",
      commitMessageTopic: "patch updates",
      schedule: ["before 6am on monday"],
    },

    // ── k8s stack groups (by app directory) ───────────────────────────
    {
      description: "Home automation stack",
      groupName: "home-automation-stack",
      matchFileNames: [
        "kubernetes/apps/home/esp-home/**",
        "kubernetes/apps/home/frigate/**",
        "kubernetes/apps/home/go2rtc/**",
        "kubernetes/apps/home/home-assistant/**",
        "kubernetes/apps/home/node-red/**",
        "kubernetes/apps/home/zigbee2mqtt/**",
        "kubernetes/apps/database/mosquitto/**",
      ],
      minimumGroupSize: 1,
    },
    {
      description: "Immich stack",
      groupName: "immich-stack",
      matchFileNames: ["kubernetes/apps/home/immich/**"],
      minimumGroupSize: 1,
    },
    {
      description: "*arr stack (includes flaresolverr)",
      groupName: "arr-stack",
      matchFileNames: [
        "kubernetes/apps/downloads/radarr/**",
        "kubernetes/apps/downloads/sonarr/**",
        "kubernetes/apps/downloads/prowlarr/**",
        "kubernetes/apps/downloads/readarr/**",
        "kubernetes/apps/downloads/bazarr/**",
        "kubernetes/apps/downloads/lidarr/**",
        "kubernetes/apps/downloads/recyclarr/**",
        "kubernetes/apps/downloads/autobrr/**",
        "kubernetes/apps/downloads/kapowarr/**",
        "kubernetes/apps/downloads/flaresolverr/**",
      ],
      minimumGroupSize: 1,
    },
    {
      description: "Downloads stack (qbittorrent + sidecars, metube, pyload)",
      groupName: "downloads-stack",
      matchFileNames: [
        "kubernetes/apps/downloads/qbittorrent/**",
        "kubernetes/apps/downloads/metube/**",
        "kubernetes/apps/downloads/pyload-ng/**",
      ],
      minimumGroupSize: 1,
    },
    {
      description: "Media stack",
      groupName: "media-stack",
      matchFileNames: ["kubernetes/apps/media/**"],
      minimumGroupSize: 1,
    },
    {
      description: "Database stack",
      groupName: "database-stack",
      matchFileNames: [
        "kubernetes/apps/database/cloudnative-pg/**",
        "kubernetes/apps/database/dragonfly/**",
        "kubernetes/apps/database/pgadmin/**",
      ],
      minimumGroupSize: 1,
    },
    {
      description: "Observability stack",
      groupName: "observability-stack",
      matchFileNames: ["kubernetes/apps/observability/**"],
      minimumGroupSize: 1,
    },
    {
      description: "Network stack",
      groupName: "network-stack",
      matchFileNames: ["kubernetes/apps/network/**"],
      minimumGroupSize: 1,
    },

    // ── k8s single-chart / ecosystem groups ───────────────────────────
    {
      description: "Cert-Manager",
      groupName: "cert-manager",
      matchFileNames: ["kubernetes/apps/security/cert-manager/**"],
      minimumGroupSize: 1,
    },
    {
      description: "Cilium",
      groupName: "cilium",
      matchFileNames: ["kubernetes/apps/kube-system/cilium/**"],
      minimumGroupSize: 1,
    },
    {
      description: "External Secrets Operator",
      groupName: "external-secrets-operator",
      matchFileNames: ["kubernetes/apps/security/external-secrets/**"],
      minimumGroupSize: 1,
    },
    {
      description: "Flux (operator + instance)",
      groupName: "flux",
      matchFileNames: [
        "kubernetes/apps/flux-system/flux-operator/**",
        "kubernetes/apps/flux-system/flux-instance/**",
      ],
      minimumGroupSize: 1,
    },
    {
      description: "Rook-Ceph",
      groupName: "rook-ceph",
      matchFileNames: ["kubernetes/apps/rook-ceph/**"],
      minimumGroupSize: 1,
    },
    {
      description: "Talos (installer + talosctl, not in kubernetes/ path)",
      groupName: "talos",
      matchDatasources: ["docker"],
      matchPackageNames: ["/installer/", "/talosctl/"],
      minimumGroupSize: 1,
    },

    // ── Infra / tooling groups ────────────────────────────────────────
    {
      description: "Terraform/OpenTofu providers",
      groupName: "terraform-providers",
      matchDatasources: ["terraform-provider"],
      minimumGroupSize: 1,
    },
    {
      description: "mise tools",
      groupName: "mise-tools",
      matchManagers: ["mise"],
      minimumGroupSize: 1,
    },
    {
      description: "GitHub Actions",
      groupName: "github-actions",
      matchManagers: ["github-actions"],
      minimumGroupSize: 1,
    },

    // ── Shared charts: group by package name (overrides path-based) ───
    // These charts are referenced from both kubernetes/apps/** and
    // kubernetes/bootstrap/helmfile.d/** (or kubernetes/components/**),
    // so a path-based group misses the bootstrap/components copy and
    // Renovate opens a duplicate ungrouped PR. Match by package instead.
    {
      description: "Flux operator + instance (all locations)",
      groupName: "flux",
      matchPackageNames: [
        "ghcr.io/controlplaneio-fluxcd/charts/flux-operator",
        "ghcr.io/controlplaneio-fluxcd/charts/flux-instance",
      ],
      minimumGroupSize: 1,
    },
    {
      description: "External Secrets (all locations)",
      groupName: "external-secrets-operator",
      matchPackageNames: ["ghcr.io/external-secrets/charts/external-secrets"],
      minimumGroupSize: 1,
    },
    {
      description: "Kube Prometheus Stack (all locations)",
      groupName: "observability-stack",
      matchPackageNames: ["ghcr.io/prometheus-community/charts/kube-prometheus-stack"],
      minimumGroupSize: 1,
    },
    {
      description: "App-template chart (all locations)",
      groupName: "app-template",
      matchPackageNames: ["ghcr.io/bjw-s-labs/helm/app-template"],
      minimumGroupSize: 1,
    },
  ],
}
